# Copy to .env and fill in. Only the provider you use needs a key.

# Which backend to use:
#   local, free:  ollama (default) | sglang | vllm
#   cloud APIs:   groq | gemini | openrouter | deepseek | openai | anthropic
#   offline:      mock
SCAMANTICS_PROVIDER=ollama

# For sglang / vllm the model is read from the server (GET /v1/models) when SCAMANTICS_MODEL is empty.

# Override the preset's model / base URL if needed
# SCAMANTICS_MODEL=gemma4:12b
# SCAMANTICS_BASE_URL=http://localhost:11434

# API keys (the preset picks the matching one; SCAMANTICS_API_KEY overrides all)
# OPENAI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# SCAMANTICS_API_KEY=

# Behaviour
# SCAMANTICS_MAX_RETRIES=1        # regenerations after a failed evidence check
# SCAMANTICS_TEMPERATURE=0
# SCAMANTICS_USE_CACHE=1          # serve cached demo answers when available / when the API is down
# SCAMANTICS_PORT=7860
# SCAMANTICS_SHARE=0              # 1 = create a public gradio.live link
